# ==============================================================================
# 应用基础配置
# ==============================================================================
APP_NAME=knowledge-graph-system
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================================================================
# LLM服务商配置
# ==============================================================================

# 默认LLM提供商: openai | anthropic | local
LLM_DEFAULT_PROVIDER=openai

# OpenAI配置
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT=60

# Anthropic配置
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096

# 本地模型配置 (vLLM/Ollama)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_TEMPERATURE=0.7
LOCAL_LLM_MAX_TOKENS=4096

# ==============================================================================
# Neo4j图数据库配置
# ==============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30

# ==============================================================================
# Redis配置
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_SSL=false
REDIS_DECODE_RESPONSES=true

# Redis键前缀
REDIS_KEY_PREFIX=kg:
REDIS_CACHE_TTL=3600
REDIS_STREAM_KEY=llm_calls_stream
REDIS_METRICS_PREFIX=metrics:

# ==============================================================================
# Postgres业务数据库配置 (可选)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kg_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DATABASE=knowledge_graph
POSTGRES_POOL_SIZE=10

# ==============================================================================
# 安全认证配置
# ==============================================================================

# JWT配置
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API认证
API_KEY_PREFIX=kg-api-
API_KEY_HEADER=X-API-Key
ADMIN_TOKEN=your-admin-token-here

# 外部API Key认证
EXTERNAL_API_KEY=your-external-api-key-here
EXTERNAL_API_IP_WHITELIST=127.0.0.1,::1

# ==============================================================================
# CORS跨域配置
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-API-Key

# ==============================================================================
# 知识图谱构建配置
# ==============================================================================

# 文本处理配置
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=200
TEXT_MAX_LENGTH=10000

# 实体抽取配置
ENTITY_EXTRACTION_PROMPT_TEMPLATES=/app/prompts/entity_extraction.txt
ENTITY_TYPES=Person,Organization,Location,Event,Concept
ENTITY_SIMILARITY_THRESHOLD=0.85

# 关系抽取配置
RELATION_EXTRACTION_PROMPT_TEMPLATES=/app/prompts/relation_extraction.txt
RELATION_TYPES=RELATED_TO,HAS_PROPERTY,PART_OF,WORKS_FOR,LOCATED_IN
RELATION_SIMILARITY_THRESHOLD=0.80

# 向量嵌入配置
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# ==============================================================================
# 推理分析配置
# ==============================================================================
REASONING_MAX_STEPS=5
REASONING_SUBGRAPH_DEPTH=3
REASONING_SUBGRAPH_MAX_NODES=100
REASONING_TEMPERATURE=0.3

# ==============================================================================
# 监控告警配置
# ==============================================================================

# 告警规则开关
ALERT_ENABLED=true
ALERT_CHECK_INTERVAL=60

# 告警阈值配置
ALERT_QPS_THRESHOLD=500
ALERT_AVG_RESPONSE_TIME_THRESHOLD=5000
ALERT_P99_RESPONSE_TIME_THRESHOLD=10000
ALERT_ERROR_RATE_THRESHOLD=0.01
ALERT_SUCCESS_RATE_THRESHOLD=0.99

# 告警通知渠道
ALERT_LOG_ENABLED=true
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
ALERT_WEBHOOK_TIMEOUT=10

# 邮件告警配置
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=kg-alerts@example.com
ALERT_EMAIL_RECIPIENTS=admin@example.com,ops@example.com

# ==============================================================================
# 成本控制配置
# ==============================================================================

# 模型Token单价 (单位: USD/1M tokens)
COST_OPENAI_GPT4O_INPUT=2.50
COST_OPENAI_GPT4O_OUTPUT=10.00
COST_OPENAI_GPT4O_MINI_INPUT=0.15
COST_OPENAI_GPT4O_MINI_OUTPUT=0.60
COST_ANTHROPIC_CLAUDE35_INPUT=3.00
COST_ANTHROPIC_CLAUDE35_OUTPUT=15.00
COST_LOCAL_MODEL_INPUT=0.00
COST_LOCAL_MODEL_OUTPUT=0.00

# 预算配置
DAILY_BUDGET_USD=100.00
MONTHLY_BUDGET_USD=2000.00
BUDGET_ALERT_THRESHOLD=0.80

# ==============================================================================
# 语义缓存配置
# ==============================================================================
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_SIZE=10000
SEMANTIC_CACHE_TTL=86400

# ==============================================================================
# 前端配置
# ==============================================================================
FRONTEND_API_BASE_URL=http://localhost:8000
FRONTEND_WS_URL=ws://localhost:8000
FRONTEND_DEFAULT_GRAPH_DEPTH=2
FRONTEND_MAX_GRAPH_NODES=500

# ==============================================================================
# 日志配置
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/kg/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ==============================================================================
# 性能优化配置
# ==============================================================================

# 连接池配置
HTTP_CONNECTION_POOL_SIZE=100
HTTP_CONNECTION_TIMEOUT=30

# 异步任务配置
ASYNC_WORKER_COUNT=4
ASYNC_TASK_TIMEOUT=300

# 缓存预热
CACHE_WARMUP_ENABLED=false
CACHE_WARMUP_ENTITIES=high_priority_entities.txt
